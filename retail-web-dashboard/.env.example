# =====================================
# Web Dashboard Configuration
# =====================================
# This file contains ALL environment variables for both backend and frontend
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your credentials
#
# For local development: Place this file in retail-web-dashboard/ directory
# For Docker Compose: Docker will read from this file automatically
# For AWS: Variables are injected by Terraform (see terraform/app-runner.tf)

# =====================================
# PostgreSQL Database Configuration
# =====================================
# Get RDS endpoint from: cd terraform && terraform output resource-ids

POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Admin123456!!
POSTGRES_DATABASE=onlinestoredb
POSTGRES_SSL=false

# =====================================
# Backend Server Configuration
# =====================================

# Server port (default: 3000)
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development

# Cache TTL in seconds (default: 5)
# How long API responses are cached before refreshing
CACHE_TTL=5

# =====================================
# Frontend Configuration
# =====================================

# API URL for frontend to connect to backend
# Local development: http://localhost:3000/api
# Docker Compose: http://backend:3000/api (handled by nginx proxy)
# AWS: Injected automatically by docker-entrypoint.sh
VITE_API_URL=http://localhost:3000/api

# =====================================
# Notes
# =====================================
#
# DOCKER COMPOSE:
#   - Place .env in retail-web-dashboard/ directory
#   - Run: docker-compose up -d
#   - Frontend: http://localhost:5173
#   - Backend: http://localhost:3000
#
# LOCAL DEVELOPMENT:
#   Backend:
#     cd backend && npm install && npm run dev
#   Frontend (separate terminal):
#     cd frontend && npm install && npm run dev
#
# AWS DEPLOYMENT:
#   - Variables are managed by Terraform (see terraform/app-runner.tf)
#   - Use: ./deploy.sh to deploy to AWS
#   - PostgreSQL vars injected from Terraform outputs
#   - VITE_API_URL injected dynamically at container startup
