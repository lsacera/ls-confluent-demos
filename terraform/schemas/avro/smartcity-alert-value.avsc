{
  "type": "record",
  "name": "SmartCityAlert",
  "namespace": "io.confluent.examples.smartcity",
  "doc": "Smart City alert generated by Flink processing (traffic incidents, air quality warnings, etc.)",
  "fields": [
    {
      "name": "alert_id",
      "type": "string",
      "doc": "Unique alert identifier"
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Alert generation timestamp in milliseconds since epoch"
    },
    {
      "name": "alert_type",
      "type": {
        "type": "enum",
        "name": "AlertType",
        "symbols": [
          "TRAFFIC_INCIDENT",
          "TRAFFIC_CONGESTION",
          "AIR_QUALITY_WARNING",
          "AIR_QUALITY_CRITICAL",
          "SERVICE_SLA_BREACH",
          "BUS_OVERCROWDED",
          "BUS_DELAYED",
          "SENSOR_OFFLINE"
        ]
      },
      "doc": "Type of alert"
    },
    {
      "name": "severity",
      "type": {
        "type": "enum",
        "name": "AlertSeverity",
        "symbols": [
          "INFO",
          "WARNING",
          "CRITICAL",
          "EMERGENCY"
        ]
      },
      "doc": "Alert severity level"
    },
    {
      "name": "district",
      "type": "string",
      "doc": "Madrid district affected by the alert"
    },
    {
      "name": "location_name",
      "type": "string",
      "doc": "Specific location name"
    },
    {
      "name": "latitude",
      "type": ["null", "double"],
      "default": null,
      "doc": "Alert location latitude (if applicable)"
    },
    {
      "name": "longitude",
      "type": ["null", "double"],
      "default": null,
      "doc": "Alert location longitude (if applicable)"
    },
    {
      "name": "message",
      "type": "string",
      "doc": "Human-readable alert message"
    },
    {
      "name": "source_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Source sensor/bus/ticket ID that triggered the alert"
    },
    {
      "name": "metric_value",
      "type": ["null", "double"],
      "default": null,
      "doc": "Metric value that triggered the alert (e.g., AQI=150, speed=15)"
    },
    {
      "name": "threshold_value",
      "type": ["null", "double"],
      "default": null,
      "doc": "Threshold value that was exceeded"
    },
    {
      "name": "resolved",
      "type": "boolean",
      "default": false,
      "doc": "Whether the alert has been resolved"
    },
    {
      "name": "resolved_at",
      "type": ["null", "long"],
      "default": null,
      "doc": "Resolution timestamp in milliseconds since epoch"
    }
  ]
}
